# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Production (Netlify): set secrets in the dashboard — see netlify.env.example
# Do not commit .env.local (it is gitignored).

# --- Evaluation API (optional) ---
# When unset, /api/evaluate uses the in-app mock report engine.
# EVAL_BACKEND_BASE_URL=https://your-eval-api.example.com

# --- Airtable lead capture ---
# Required in production for partner + evaluate + DIY forms to persist leads.
# Create token: https://airtable.com/create/tokens
# Scopes: data.records:write (schema.bases:write only needed for npm run setup:airtable)

# Secret — set in .env.local locally and in Netlify UI (never commit the real value).
AIRTABLE_PAT=

# Aggar base (from https://airtable.com/app35phakMmxSxxIe/...)
AIRTABLE_BASE_ID=app35phakMmxSxxIe

# Table names (must match tables created by npm run setup:airtable)
AIRTABLE_PARTNERS_TABLE=Partner Applications
AIRTABLE_LEADS_TABLE=Evaluation Leads
