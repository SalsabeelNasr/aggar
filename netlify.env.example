# Netlify environment variables — REQUIRED for production lead capture
#
# Option A (recommended): Netlify UI
#   Site configuration → Environment variables → Add variable
#   Mark AIRTABLE_PAT as "Secret". Scope: Production.
#
# Option B: CLI (uses values from your local .env.local)
#   npx netlify-cli login
#   npm run netlify:env
#   Then trigger a new deploy.
#
# Without AIRTABLE_PAT, production builds will fail (by design).

AIRTABLE_PAT=patxxxxxxxxxxxxxxxx

# Non-secret (also set in netlify.toml [build.environment] — keep in sync)
AIRTABLE_BASE_ID=app35phakMmxSxxIe
AIRTABLE_PARTNERS_TABLE=Partner Applications
AIRTABLE_LEADS_TABLE=Evaluation Leads

# OPTIONAL — external evaluation API instead of mock
# EVAL_BACKEND_BASE_URL=https://your-eval-api.example.com
