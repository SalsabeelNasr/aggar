# Netlify environment variables checklist
# Site settings → Environment variables → Add each variable
# https://docs.netlify.com/environment-variables/overview/
#
# Mark AIRTABLE_PAT as "Secret" (contains sensitive values).
# Apply to: Production (and Deploy Previews if you want leads there too).

# REQUIRED for lead capture in production
AIRTABLE_PAT=patxxxxxxxxxxxxxxxx

# Non-secret (also set in netlify.toml [build.environment] — keep in sync)
AIRTABLE_BASE_ID=app35phakMmxSxxIe
AIRTABLE_PARTNERS_TABLE=Partner Applications
AIRTABLE_LEADS_TABLE=Evaluation Leads

# OPTIONAL — external evaluation API instead of mock
# EVAL_BACKEND_BASE_URL=https://your-eval-api.example.com
